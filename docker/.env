# PostgreSQL
POSTGRES_USER=ielts
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=ielts_db
PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ielts:change-this-password@postgres:5432/ielts_db

# Backend
SECRET_KEY=change-this-secret-key
DEBUG=false
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=info

# Frontend
FRONTEND_PORT=8080
NODE_ENV=production

# Keep this empty when Nginx proxies /api to the backend in the same compose stack.
VITE_API_BASE_URL=
